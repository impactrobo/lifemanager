{
  // Aesthetic FX modules are the one part of this codebase that is real TypeScript and does
  // get compiled: `npm run build:fx` emits `fx.js` next to each `fx.ts`, and that .js is
  // COMMITTED so GitHub Pages can serve it with no build on the host.
  //
  // Held to a stricter bar than app.js on purpose — this is new code with no legacy to carry,
  // and an FX module that leaks a rAF loop bleeds into whatever theme you switch to next.
  // The main tsconfig.json deliberately does NOT cover these files; `npm run typecheck` runs
  // both configs.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["aesthetics/**/*.ts", "types/**/*.d.ts"]
}
