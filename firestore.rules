rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only ever read or write their OWN document, at users/{their own uid}.
    // request.auth.uid is set by Firebase Auth itself and cannot be spoofed by the client —
    // this is the actual access control, not anything enforced in the app's own JS code.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
